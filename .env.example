# Database
DATABASE_URL=postgresql://postgres:123456@localhost/car_rental

# Authentication - replace these values before exposing the app publicly
APP_SECRET_KEY=replace-with-a-long-random-secret
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password

# Server and CORS
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173

# SMTP password should be an app password when using Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Configure at least one provider to enable AI chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_NAME=Phuong Dong Car Rental
OPENROUTER_SITE_URL=http://localhost:5173
