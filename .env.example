# SMTP cấu hình để gửi email OTP quên mật khẩu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=mat-khau-ung-dung-hoac-password
SMTP_FROM=you@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Lưu ý: Backend sẽ dùng tài khoản SMTP này để gửi đến email người dùng yêu cầu quên mật khẩu.
# Nếu dùng Gmail, hãy dùng App Password (không dùng mật khẩu đăng nhập Gmail thông thường).
# Mã OTP sẽ được gửi cho tất cả các địa chỉ email người dùng hợp lệ.
# Ghi chú: Backend sẽ gửi mã OTP đến email người dùng đăng ký yêu cầu quên mật khẩu.
# Chỉ cần một tài khoản gửi (SMTP_USERNAME) để phục vụ cho tất cả các email người dùng.
